// Windows resource: exe icon plus version metadata, compiled by
// embed-resource on Windows targets. The icon MUST keep numeric id 1:
// gpui's Windows backend loads the window-class icon via LoadImageW
// with resource id 1, so a named icon is silently ignored.
1 ICON "assets/icon.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NotiFansly"
            VALUE "FileDescription", "NotiFansly Desktop"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "notifansly-desktop"
            VALUE "LegalCopyright", "Copyright (c) 2026 NotiFansly"
            VALUE "OriginalFilename", "notifansly-desktop.exe"
            VALUE "ProductName", "NotiFansly Desktop"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
